[gd_resource type="Resource" script_class="ChoiceData" load_steps=2 format=3]
[ext_resource type="Script" path="res://scripts/story/choice_data.gd" id="1"]
[resource]
script = ExtResource("1")
stable_id = &"zone2-sentinel-lost"
encounter_id = &"zone2-net-sentinel"
resonance_delta = -15
flags = Array[StringName]([&"zone2-sentinel-lost", &"zone2-wardens-hostile"])
action_text = "Record the lost animal"
response_text = "Wick: The sentinel is dead following the weapon impact. The damaged net and our recordings remain. No living specimen can be delivered.\n\nOkafor: Record what happened. Do not mistake this for a successful collection.\n\nCrane: Bring back the evidence. There is no specimen allowance for this loss."
