extends "res://tests/fixtures/drive_chapter_handoff.gd"
## Whole chapter via real movement, remappable action events and actual menu focus.
var _sentinel_outcome: String
var _deep_started: float
func _after_deployment() -> bool:
	_sentinel_outcome = _argument("--sentinel","release")
	_deep_started = _clock.seconds
	print("TWILIGHT_STORY_BEGIN outcome=",_sentinel_outcome)
	var original: Dictionary = _scene.saves.progress_snapshot()
	var prior_points: int = CampaignData.earned(_scene.revision.campaign)
	if _sentinel_outcome=="release":
		await _move(Vector2(30600,1400))
		await _move(Vector2(29000,1800))
		await _move(Vector2(28050,1860))
		await _record(&"twilight-mara-log-two")
		await _capture("optional-mara-logger")
		await _west_marking()
		await _cable_records()
		await _net_choice()
	else:
		await _cable_records()
		await _move(Vector2(35800,1400))
		await _move(Vector2(37800,1720))
		await _move(Vector2(38450,1720))
		await _record(&"twilight-mara-log-three")
		await _net_choice()
		await _west_marking()
	assert(TwilightShelfData.ready(_scene.research,_scene.story))
	assert(_scene.missions.snapshot()[String(TwilightShelfData.MISSION)].state=="accepted")
	await _tap(JOY_BUTTON_X)
	await _frames(160)
	await _tap(JOY_BUTTON_BACK)
	assert(_scene.exploration_map.visible)
	await _capture("twilight-discovered-map")
	await _tap(JOY_BUTTON_BACK)
	if _scene.submarine.global_position.x>36600: await _move(Vector2(37800,2900))
	elif _scene.submarine.global_position.x<35000: await _move(Vector2(33000,2900))
	await _move(Vector2(35800,2900))
	await _move(Vector2(35800,1400))
	await _move(TwilightShelfLayout.SPAWN)
	assert(_scene.submarine.resource_system.battery>25 and _scene.submarine.resource_system.oxygen>25)
	var seconds: float = _clock.seconds-_deep_started
	await _interact()
	await _activate(_control("ReturnHalcyon"))
	await _wait_transfer()
	assert(_scene.journey.at_station())
	assert(_scene.missions.snapshot()[String(TwilightShelfData.MISSION)].state=="completed")
	await _activate(_control("TwilightDebrief"))
	await _capture("twilight-debrief-before-claim")
	await _activate(_control("SubmitTwilight"))
	assert(_scene.journey.expedition.concluded())
	# Optional log XP can add at most the existing capped science point; count authored allowance IDs independently.
	assert("twilight-expedition" in _scene.revision.campaign.awards)
	assert(("twilight-specimen" in _scene.revision.campaign.awards)==(_sentinel_outcome=="capture"))
	assert(CampaignData.earned(_scene.revision.campaign)>=prior_points+(3 if _sentinel_outcome=="capture" else 2))
	assert(_choice_events==2 and _ack_events==2)
	await _activate(_control("Technology"))
	await _capture("twilight-research-allowance")
	await _activate(_control("BackOperations"))
	await _activate(_control("TwilightDebrief"))
	await _activate(_control("SubmitTwilight"))
	assert(_ack_events==2)
	await _activate(_control("Depart"))
	await _wait_transfer()
	await _tap(JOY_BUTTON_START)
	await _activate(_scene.route_menu.get_node("%SaveExpedition") as Control)
	for id: String in original.research: assert(id in _scene.saves._state.progress.research)
	print("TWILIGHT_EXPEDITION_INPUT_PASS outcome=",_sentinel_outcome," input=",("keyboard" if _keyboard else "controller")," deep_simulation_seconds=",seconds," choices=",_choice_events," acknowledgements=",_ack_events," shots=",_shots," optional_logs_not_required=true")
	await _finish_process()
	return true
func _west_marking() -> void:
	if _scene.submarine.global_position.x<30000:
		await _move(Vector2(29000,2900))
	else:
		if _scene.submarine.global_position.y<1700: await _move(Vector2(35800,1400))
		await _move(Vector2(35800,2900))
		await _move(Vector2(33000,2900))
		await _move(Vector2(29000,2900))
	await _move(Vector2(29100,3100))
	await _capture("whaler-before-scan")
	await _record(&"twilight-whaler-marking")
	await _capture("unclassified-marking")
func _cable_records() -> void:
	# Go around the central rock mass, never through it.
	if _scene.submarine.global_position.y<1700:
		await _move(Vector2(35800,1400))
	elif _scene.submarine.global_position.x<35000:
		await _move(Vector2(33000,2900))
		await _move(Vector2(35800,2900))
	await _move(Vector2(35800,1940))
	await _move(Vector2(35950,1940))
	await _capture("severed-sensor-line")
	await _record(&"twilight-severed-cable")
	await _move(Vector2(35800,2820))
	await _record(&"twilight-mara-log-one")
	await _capture("mara-first-log")
func _net_choice() -> void:
	if _scene.submarine.global_position.x>37300: await _move(Vector2(37800,2900))
	else: await _move(Vector2(35800,2900))
	await _move(Vector2(37800,2900))
	await _move(Vector2(37700,3100))
	await _tap(JOY_BUTTON_X)
	await _frames(160)
	await _capture("sentinel-in-drift-net")
	await _record(&"twilight-net-survey")
	await _interact()
	await _capture("sentinel-choice")
	await _activate(_control("StoryBack"))
	assert(not _scene.story.resolved(TwilightShelfData.ENCOUNTER))
	await _interact()
	if _sentinel_outcome=="capture":
		await _activate(_control("CaptureSentinel"))
		await _capture("capture-confirmation")
		await _activate(_control("ConfirmCaptureSentinel"))
	else:
		await _activate(_control("ReleaseSentinel"))
	# Pause freezes work, not just the progress bar.
	await _frames(80)
	await _tap(JOY_BUTTON_START)
	var progress: float = _scene.journey.expedition.elapsed
	await _frames(45)
	assert(is_equal_approx(progress,_scene.journey.expedition.elapsed))
	await _tap(JOY_BUTTON_START)
	await _capture("sentinel-action-progress")
	await _frames(400)
	assert(_scene.story.has_decision(TwilightShelfData.CAPTURE if _sentinel_outcome=="capture" else TwilightShelfData.RELEASE))
	await _capture("sentinel-outcome")
	await _activate(_control("ReturnFromSentinel"))
	await _frames(180)
	await _capture("sentinel-habitat-after")
func _record(id: StringName) -> void:
	print("TWILIGHT_RECORD_BEGIN ",id," at=",_scene.submarine.global_position)
	assert(not _scene.research.is_completed(id))
	var target: Vector2 = _scene.research.definition(id).position
	var offset: Vector2 = Vector2(80,140) if id==&"twilight-net-survey" else Vector2(130,50)
	await _move(target-offset-Vector2(130,0),true)
	await _move(target-offset,true)
	await _interact()
	await _frames(340)
	if not _scene.research.is_completed(id):
		push_error("Normal Interact did not complete "+String(id)+" at "+str(_scene.submarine.global_position)+" scanner="+str(_scene.submarine.scanner.snapshot()))
		quit(1)
	print("TWILIGHT_RECORD_PASS ",id)
	await _capture(String(id))
func _resume_twilight() -> void:
	_keyboard = _argument("--input","controller")=="keyboard"
	_outcome = _argument("--outcome","collect")
	_sentinel_outcome = _argument("--sentinel","capture")
	_captures = OS.get_environment("BTA_EVIDENCE_DIR")
	_small = OS.get_cmdline_user_args().has("--small")
	_scene = load("res://scenes/main/main.tscn").instantiate() as ShelfPrototype
	_scene.settings_path = "user://"+_argument("--profile","bta055-route")+".json"
	_scene.expedition_path = _scene.settings_path+".expedition.json"
	root.add_child(_scene)
	root.size = Vector2i(800,600) if _small else Vector2i(1280,800)
	await _frames(10)
	var before: Dictionary = _scene.saves._state.duplicate(true)
	assert(_scene.journey.expedition.concluded())
	_scene.missions.acknowledgement_claimed.connect(func(_id: StringName,_ack: StringName) -> void: _ack_events+=1)
	_scene.story.choice_applied.connect(func(_id: StringName,_encounter: StringName) -> void: _choice_events+=1)
	await _activate(_control("Begin"))
	await _wait_transfer()
	assert(_scene.journey.active())
	assert(_scene.journey.expedition.concluded())
	assert(_scene.submarine.global_position.distance_to(Vector2(before.player.position[0],before.player.position[1]))<1)
	assert(absf(_scene.submarine.resource_system.battery-before.player.battery)<0.2)
	var expected: float = _scene.revision.tree.sonar_radii[int(_scene.revision.campaign.ranks.sonar)]+(100.0 if _sentinel_outcome=="capture" else 0.0)
	assert(_scene.revision.capabilities().sonar==expected)
	await _capture("twilight-continue-no-replay")
	await _interact()
	await _activate(_control("ReturnHalcyon"))
	await _wait_transfer()
	await _activate(_control("TwilightDebrief"))
	await _capture("twilight-persistent-debrief")
	await _activate(_control("SubmitTwilight"))
	assert(_scene.saves.progress_snapshot()==before.progress)
	assert(_scene.revision.campaign==before.prototype.campaign)
	assert(_choice_events==0 and _ack_events==0)
	print("TWILIGHT_EXPEDITION_CONTINUE_PASS outcome=",_sentinel_outcome," input=",("keyboard" if _keyboard else "controller")," choices=",_choice_events," acknowledgements=",_ack_events)
	await _finish_process()
func _capture(name: String) -> void:
	if not _captures.is_empty():
		await process_frame
		RenderingServer.force_draw(false,0.0)
		await process_frame
	await super._capture(name)
