[node name="Brief" type="Label" parent="Center/Panel/Content"]
unique_name_in_owner = true
layout_mode = 2
text = "Explore Base → Cave → Twin Spires → Base. Move: WASD / stick.
Sonar: F / X · Interact/scan/station: E / A · Map: M / Back.
Save while safely paused. Continue resumes your checkpoint.
New Expedition resets vessel/route and retains permanent progress."
