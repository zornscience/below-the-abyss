[ext_resource type="Script" path="res://scripts/story/choice_data.gd" id="1"]
[resource]
script = ExtResource("1")
stable_id = &"zone1-light-bloom-observe"
encounter_id = &"zone1-light-bloom"
resonance_delta = 15
flags = Array[StringName]([&"zone1-light-bloom-unharmed"])
research_record_id = &"zone1-light-bloom-scan"
action_text = "Scan and leave the bloom unharmed"
response_text = "Wick: Scan stored aboard. The sampler is closed; the plankton is still glowing.\n\nOkafor: A spiral, then a scatter. Keep the recording and leave the bloom unharmed.\n\nCrane: I requested a sample. Send the scan to Halcyon for now."
