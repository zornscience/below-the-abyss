extends "res://tests/fixtures/drive_sunlit_environment.gd"
## Real inputs from Chapter 1 through commissioning; separate process proves deep Continue.
func _initialize() -> void:
	if OS.get_cmdline_user_args().has("--twilight-resume"): _resume_twilight.call_deferred()
	else: super._initialize()
func _after_buoy_recovery() -> bool:
	assert(_scene.journey.can_finish())
	await _interact()
	assert(_scene.revision.ui.radio_page.visible and not _scene.submarine.is_physics_processing())
	await _capture("finish-chapter-choice")
	await _activate(_control("StoryBack"))
	assert(not _scene.chapter.concluded() and _scene.submarine.is_physics_processing())
	await _interact()
	await _activate(_control("FinishChapterAtBuoy"))
	await _wait_transfer()
	assert(_scene.chapter.concluded() and _ack_events==1)
	await _capture("first-chapter-debrief")
	await _activate(_control("ExploreTwilight"))
	await _capture("deep-commissioning")
	await _activate(_control("BeginTwilight"))
	await _wait_transfer()
	assert(_scene.journey.active())
	assert((_scene.submarine.get_node("Camera2D") as Camera2D).get_screen_center_position().distance_to(TwilightShelfLayout.SPAWN)<1)
	assert(_scene.submarine.global_position.distance_to(TwilightShelfLayout.SPAWN)<1)
	assert(_scene.submarine.hull_system.hull==100)
	assert(_scene.submarine.resource_system.battery>99.9 and _scene.submarine.resource_system.oxygen>99.9)
	assert(_scene.torpedoes.ammunition==10 and _scene.submarine.damage_system.get_maximum_depth_m()>=1000)
	assert(not _scene.chapter.departure.is_visible_in_tree() and not _scene.chapter.ocean.is_visible_in_tree())
	await _capture("deep-start-350m")
	await _tap(JOY_BUTTON_X)
	var course: Array[Vector2] = TwilightShelfLayout.WEST_LOOP if _keyboard else TwilightShelfLayout.EAST_LOOP
	for index: int in range(1,course.size()):
		await _move(course[index])
		if index==2: await _capture("west-passage" if _keyboard else "east-passage")
		if index==4: await _capture("lower-loop")
	assert(_scene.submarine.resource_system.battery<99)
	await _tap(JOY_BUTTON_BACK)
	assert(_scene.exploration_map.visible and _scene.exploration_map.canvas.points.is_empty())
	await _capture("deep-exploration-map")
	await _tap(JOY_BUTTON_BACK)
	await _move(Vector2(30600,1400))
	await _tap(JOY_BUTTON_START)
	await _activate(_scene.route_menu.get_node("%SaveExpedition") as Control)
	assert(_scene.saves._state.region_id==ExpeditionJourneyState.TWILIGHT)
	assert(_scene.saves._state.player.battery<99)
	assert(_choice_events==1 and _ack_events==1)
	print("CHAPTER_HANDOFF_CHECKPOINT_PASS input=",("keyboard" if _keyboard else "controller")," outcome=",_outcome," battery=",_scene.saves._state.player.battery," hull=",_scene.saves._state.player.hull," shots=",_shots)
	await _finish_process()
	return true
func _resume_twilight() -> void:
	_keyboard = _argument("--input","controller")=="keyboard"
	_outcome = _argument("--outcome","collect")
	_captures = OS.get_environment("BTA_EVIDENCE_DIR")
	_small = OS.get_cmdline_user_args().has("--small")
	_scene = load("res://scenes/main/main.tscn").instantiate() as ShelfPrototype
	_scene.settings_path = "user://"+_argument("--profile","bta053-handoff")+".json"
	_scene.expedition_path = _scene.settings_path+".expedition.json"
	root.add_child(_scene)
	root.size = Vector2i(800,600) if _small else Vector2i(1280,800)
	await _frames(10)
	assert(_scene.saves.has_checkpoint() and _scene.journey.state.phase=="twilight")
	var checkpoint: Dictionary = _scene.saves._state.duplicate(true)
	_scene.missions.acknowledgement_claimed.connect(func(_id: StringName,_ack: StringName) -> void: _ack_events+=1)
	_scene.story.choice_applied.connect(func(_id: StringName,_encounter: StringName) -> void: _choice_events+=1)
	await _activate(_control("Begin"))
	await _wait_transfer()
	assert(_scene.journey.active())
	assert(_scene.submarine.global_position.distance_to(Vector2(checkpoint.player.position[0],checkpoint.player.position[1]))<1)
	assert(absf(_scene.submarine.resource_system.battery-checkpoint.player.battery)<0.2)
	assert(absf(_scene.submarine.resource_system.oxygen-checkpoint.player.oxygen)<0.2)
	assert(_scene.submarine.hull_system.hull==checkpoint.player.hull)
	assert(_scene.torpedoes.ammunition==int(checkpoint.prototype.ammunition))
	assert(_scene.submarine.damage_system.get_maximum_depth_m()>=1000)
	await _capture("continue-supplies-preserved")
	await _move(TwilightShelfLayout.SPAWN)
	assert(_scene.submarine.resource_system.battery<99)
	await _interact()
	await _capture("return-tether-choice")
	await _activate(_control("StoryBack"))
	assert(_scene.submarine.is_physics_processing())
	assert(_scene.submarine.resource_system.battery<99)
	await _interact()
	await _activate(_control("ReturnHalcyon"))
	await _wait_transfer()
	assert(_scene.journey.at_station() and _scene.revision.ui.dock_page.visible)
	assert(not _scene.submarine.is_physics_processing())
	assert(_scene.submarine.resource_system.battery==100 and _scene.torpedoes.ammunition==10)
	await _capture("halcyon-refit")
	await _activate(_control("Technology"))
	await _activate(_control("ReassignAll"))
	await _activate(_control("engineAssign"))
	assert(int(_scene.revision.campaign.ranks.engine)==1)
	await _capture("research-refit")
	await _activate(_control("BackOperations"))
	await _activate(_control("Depart"))
	await _wait_transfer()
	assert(_scene.journey.active() and _scene.submarine.is_physics_processing())
	assert(_scene.submarine.global_position.distance_to(TwilightShelfLayout.SPAWN)<1)
	assert(int(_scene.revision.campaign.ranks.engine)==1 and _scene.submarine.damage_system.get_maximum_depth_m()>=1000)
	assert(_scene.saves.progress_snapshot()==checkpoint.progress)
	assert(_choice_events==0 and _ack_events==0)
	await _capture("resume-from-tether")
	print("CHAPTER_HANDOFF_INPUT_PASS input=",("keyboard" if _keyboard else "controller")," outcome=",_outcome," replayed_choices=",_choice_events," replayed_claims=",_ack_events)
	await _finish_process()
func _finish_process() -> void:
	if _clock!=null: _clock.queue_free()
	_scene.queue_free()
	await _frames(5)
	quit()

func _wait_transfer() -> void:
	for unused: int in range(120):
		await physics_frame
		if not _scene.journey.transitioning:
			await process_frame
			return
	push_error("Chapter transfer did not finish its bounded camera settle.")
	quit(1)
